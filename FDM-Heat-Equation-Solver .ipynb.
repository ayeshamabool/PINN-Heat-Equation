        "#Environment Setup & Parameters\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Parameters\n",
        "L = 1.0      # Domain length [m]\n",
        "T = 1.0      # Total time [s]\n",
        "alpha = 0.1  # Thermal diffusivity [m^2/s]\n",
        "Nx = 100     # Spatial discretization\n",
        "Nt = 2500    # Temporal discretization\n",
        "\n",
        "dx = L / (Nx-1)\n",
        "dt = T / (Nt-1)\n",
        "r = alpha * dt / (dx**2)\n",
        "\n",
        "#Logs\n",
        "print(\"=\"*50)\n",
        "print(\"PROJECT: Numerical Solution of 1D Heat Equation\")\n",
        "print(f\"Method: Explicit Finite Difference\")\n",
        "print(\"=\"*50)\n",
        "print(f\"[PARAM] L={L}, T={T}, alpha={alpha}\")\n",
        "print(f\"[GRID] Nx={Nx}, Nt={Nt}, dx={dx:.4f}, dt={dt:.4f}\")\n",
        "print(f\"[CHECK] CFL Stability r = {r:.4f}\")\n",
        "\n",
        "if r <= 0.5:\n",
        "    print(f\"[STATUS] Stability Condition Satisfied ✓ (r <= 0.5)\")\n",
        "else:\n",
        "    print(f\"[STATUS] Stability Violated ✗ - Reduce dt\")"
      ],
