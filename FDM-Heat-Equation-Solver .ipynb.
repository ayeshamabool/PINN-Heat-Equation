    {
      "cell_type": "code",
      "source": [
        "#CORRECTED - Fast PINN Training (1000 epochs only)\n",
        "import torch\n",
        "\n",
        "x_train = torch.rand(2000, 1)\n",
        "t_train = torch.rand(2000, 1)\n",
        "x_train.requires_grad = True\n",
        "t_train.requires_grad = True\n",
        "\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
        "\n",
        "print(\"[TRAINING] Starting PINN (1000 epochs) - Fixed Version...\")\n",
        "\n",
        "for epoch in range(1000):\n",
        "    optimizer.zero_grad()\n",
        "    u_pred = model(x_train, t_train)\n",
        "\n",
        "    u_t = torch.autograd.grad(u_pred, t_train, grad_outputs=torch.ones_like(u_pred), create_graph=True)[0]\n",
        "    u_x = torch.autograd.grad(u_pred, x_train, grad_outputs=torch.ones_like(u_pred), create_graph=True)[0]\n",
        "    u_xx = torch.autograd.grad(u_x, x_train, grad_outputs=torch.ones_like(u_x), create_graph=True)[0]\n",
        "\n",
        "    pde_loss = torch.mean((u_t - 0.1 * u_xx)**2)\n",
        "\n",
        "    # BC Loss simple\n",
        "    x0 = torch.zeros(200,1)\n",
        "    x1 = torch.ones(200,1)\n",
        "    t_b = torch.rand(400,1)\n",
        "    u0 = model(x0, t_b[:200])\n",
        "    u1 = model(x1, t_b[200:])\n",
        "    bc_loss = torch.mean(u0**2 + u1**2)\n",
        "\n",
        "    loss = pde_loss + bc_loss\n",
        "    loss.backward()\n",
        "    optimizer.step()\n",
        "\n",
        "    if (epoch+1) % 200 == 0:\n",
        "        print(f\"[EPOCH {epoch+1}/1000] Loss: {loss.item():.6f}\")\n",
        "\n",
        "print(\"[SUCCESS] PINN Training Complete ✓\")"
      ],
