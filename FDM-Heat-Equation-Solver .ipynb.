        "#Explicit FDM Solver\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "print(\"[SOLVER] Starting Explicit FDM iterations...\")\n",
        "for n in range(0, Nt-1):\n",
        "    for j in range(1, Nx-1):\n",
        "        u[n+1, j] = u[n, j] + r * (u[n, j+1] - 2*u[n, j] + u[n, j-1])\n",
        "\n",
        "print(f\"[SUCCESS] Solver Converged | Iterations: {Nt}\")\n",
        "\n",
        "# Professional Plot\n",
