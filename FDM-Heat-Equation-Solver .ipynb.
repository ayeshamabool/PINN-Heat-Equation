        "#PINN Setup - Scientific Machine Learning\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "print(f\"[INFO] PyTorch Version: {torch.__version__}\")\n",
        "\n",
        "# Define Neural Network - 3 Layers [2 -> 50 -> 50 -> 1]\n",
        "class PINN(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            nn.Linear(2, 50), nn.Tanh(),\n",
        "            nn.Linear(50, 50), nn.Tanh(),\n",
        "            nn.Linear(50, 1)\n",
        "        )\n",
        "    def forward(self, x, t):\n",
        "        inputs = torch.cat([x, t], dim=1)\n",
        "        return self.net(inputs)\n",
        "\n",
        "model = PINN()\n",
        "print(\"[SUCCESS] PINN Model Initialized: 2-50-50-1 Architecture\")\n",
        "print(f\"[PARAMS] Total Trainable Params: {sum(p.numel() for p in model.parameters())}\")"
      ],
