      "source": [
        "#Initialization & Conditions\n",
        "import numpy as np\n",
        "\n",
        "x = np.linspace(0, L, Nx)\n",
        "t = np.linspace(0, T, Nt)\n",
        "\n",
        "# Solution matrix [Time, Space]\n",
        "u = np.zeros((Nt, Nx))\n",
        "\n",
        "# Initial Condition: u(0,x) = sin(pi*x)\n",
        "u[0, :] = np.sin(np.pi * x)\n",
        "\n",
        "# Boundary Conditions\n",
        "u[:, 0] = 0\n",
        "u[:, -1] = 0\n",
        "\n",
        "print(\"=\"*50)\n",
        "print(f\"[INIT] Initial Condition: u(0,x) = sin(πx)\")\n",
        "print(f\"[INIT] Boundary: u(t,0)=0, u(t,1)=0\")\n",
        "print(f\"[SHAPE] Solution Matrix: {u.shape}\")\n",
        "print(f\"[CHECK] Max Initial Temp: {np.max(u[0,:]):.4f} at x={x[np.argmax(u[0,:])]:.2f}\")\n",
        "print(\"=\"*50)"
      ],
